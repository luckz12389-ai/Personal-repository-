	local function walkToDoor()
		if walkBusy then return end
		local rt, hum = getRoot(), getHum()
		if not rt or not hum or hum.Health <= 0 then return end
		local room = roomsFolder and roomsFolder:FindFirstChild(tostring(latestRoomNum()))
		local door = room and room:FindFirstChild("Door")
		local dp = door and door:FindFirstChild("Door")
		if not dp then return end
		walkBusy = true
		pcall(function()
			local path = PFS:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
			path:ComputeAsync(rt.Position, dp.Position)
			if path.Status == Enum.PathStatus.Success then
				for _, wp in ipairs(path:GetWaypoints()) do
					if not alive or not S.autoWalk then break end
					if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
					hum:MoveTo(wp.Position)
					local t0 = os.clock()
					repeat task.wait(0.1) until (rt.Position - wp.Position).Magnitude < 4 or os.clock() - t0 > 1.5 or not alive
					if (rt.Position - dp.Position).Magnitude < 9 then break end
				end
			end
			local prompt = door:FindFirstChildWhichIsA("ProximityPrompt", true)
			if prompt and (rt.Position - dp.Position).Magnitude < 14 then fire(prompt) end
		end)
		walkBusy = false
	end

