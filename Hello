	local function classify(i)
		local n, isM = i.Name, i:IsA("Model")
		if isM and F.ent[n] then return "entities", F.ent[n] end
		if isM and i.Parent == workspace and n:match("Moving$") then return "entities", (n:gsub("Moving$", "")) end
		if isM and F.trap[n] then return "traps", F.trap[n] end
		if (isM or i:IsA("BasePart")) and F.item[n] then return "items", F.item[n] end
		if isM and F.gold[n] then return "gold", F.gold[n] end
		if isM and F.hide[n] then return "hide", F.hide[n] end
		local ln = n:lower()
		if isM then
			local par = i.Parent
			local cr = workspace:FindFirstChild("CurrentRooms")
			if par == workspace or (par and cr and par.Parent == cr) then
				for pat, disp in pairs(EVENT_ENT) do
					if ln:find(pat, 1, true) then return "entities", disp end
				end
			end
		end
		if (isM or i:IsA("BasePart")) and (ln:find("candy", 1, true) or ln:find("cauldron", 1, true)) then
			local pm = i.Parent
			if i:IsA("BasePart") and pm and pm:IsA("Model") and pm.Name:lower():find("candy", 1, true) then return nil end
			return "candy", ln:find("cauldron", 1, true) and "Cauldron" or "Candy"
		end
		return nil
	end

	local entSeen = 0
	local function handle(inst, silent)
		local cat, text = classify(inst)
		if cat then
			tryAdd(inst, text, cat)
			if cat == "entities" and not seen[inst] then
				seen[inst] = true
				if not silent then
					local now = os.clock()
					if now - (notifiedAt[text] or 0) > 4 then
						notifiedAt[text] = now
						entSeen += 1
						if S.notify then notify(text .. " spawned", HINT[text] or "Be careful!", T.red, S.notifyTime, "alert") end
						if S.flash then flashScreen(T.red) end
						if S.whEntity then sendWebhook(text .. " spawned", HINT[text] or "Be careful!", 16711680) end
					end
				end
			end
		end
		if inst:IsA("ProximityPrompt") then
			if not prompts[inst] then regPrompt(inst) end
			if S.smart then smartAdd(inst) end
		end
	end

