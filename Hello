		if S.whDeath then sendWebhook("Player died", "Died on " .. F.name .. " at room " .. tostring(latestRoomNum()), 15158332) end
		if S.deathMode == "off" or deathBusy then return end
		deathBusy = true
		log("you died. mode: " .. S.deathMode)
		task.spawn(function()
			task.wait(S.deathDelay)
			if not alive then deathBusy = false return end
			if S.deathMode == "revive" then
