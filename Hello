	local function kindOf(p)
		local a = (p.ActionText or ""):lower()
		if p.Name == "HidePrompt" or a == "hide" then return "hide" end
		if p:FindFirstAncestor("Door") and (p.Name == "EnterPrompt" or p.Name == "UnlockPrompt" or a == "open" or a == "unlock") then return "door" end
		return "other"
	end
	local function promptHas(p, list)
		local s = ((p.ObjectText or "") .. " " .. (p.ActionText or "") .. " " .. (p.Parent and p.Parent.Name or "")):lower()
		local m = p:FindFirstAncestorOfClass("Model")
		if m then s = s .. " " .. m.Name:lower() end
		for _, w in ipairs(list) do
			if s:find(w, 1, true) then return true end
		end
		return false
	end
	local function promptPos(p)
		local par = p.Parent
		if not par then return nil end
		if par:IsA("Attachment") then return par.WorldPosition end
		if par:IsA("BasePart") then return par.Position end
		if par:IsA("Model") then return par:GetPivot().Position end
	end
	local function fire(p)
		if fireproximityprompt then pcall(fireproximityprompt, p)
		else task.spawn(function() pcall(function() p:InputHoldBegin() task.wait() p:InputHoldEnd() end) end) end
	end

	local SMART = { collect = 1, grab = 1, take = 1, ["pick up"] = 1, loot = 1, pull = 1, unlock = 1, activate = 1 }
	local function smartAdd(p)
		local k = kindOf(p)
		if k == "door" then return end
		local a = (p.ActionText or ""):lower()
		if k ~= "hide" and not SMART[a] then return end
		local par = p.Parent
		local part = par and (par:IsA("Attachment") and par.Parent or par)
		local m = p:FindFirstAncestorOfClass("Model")
		local tgt = part
		if m and m ~= workspace then
			local ok, sz = pcall(function() return m:GetExtentsSize().Magnitude end)
			if ok and sz < 30 then tgt = m end
		end
		if not tgt or esp[tgt] then return end
		if k == "hide" then tryAdd(tgt, (m and m.Name) or "Hide", "hide")
		else tryAdd(tgt, (p.ObjectText ~= "" and p.ObjectText) or (m and m.Name) or "Item", "items") end
	end

