local CFG_FILE = "DoorsHub/config.json"
local function packConfig(S)
	local t, o = {}, {}
	for k, v in pairs(S) do
		local tv = typeof(v)
		if tv == "boolean" or tv == "number" or tv == "string" then
			t[k] = v
		elseif tv == "Color3" then
			t[k] = "#" .. v:ToHex()
		end
	end
	o.sfx, o.vol, o.scale = Opt.sfx, Opt.vol, Opt.scale
	t.__opt = o
	return t
end
local function saveConfig(S, file)
	return pcall(function()
		if isfolder and not isfolder("DoorsHub") then makefolder("DoorsHub") end
		writefile(file or CFG_FILE, HttpService:JSONEncode(packConfig(S)))
	end)
end
local function loadConfig(S, file)
	return pcall(function()
		local f = file or CFG_FILE
		if not (isfile and isfile(f)) then error("no config") end
		local data = HttpService:JSONDecode(readfile(f))
		for k, v in pairs(data) do
			if k == "__opt" and type(v) == "table" then
				for ok2, ov in pairs(v) do
					if Opt[ok2] ~= nil and type(ov) == type(Opt[ok2]) then Opt[ok2] = ov end
				end
			elseif S[k] ~= nil then
				if typeof(S[k]) == "Color3" and type(v) == "string" then
					S[k] = Color3.fromHex(v)
				elseif type(v) == type(S[k]) then
					S[k] = v
				end
			end
		end
	end)
end

