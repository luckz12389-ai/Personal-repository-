	Toggle(pSet, "Floating button", "floatBtn")
	Toggle(pSet, "FPS / Ping display", "hud")
	Bind(pSet, "Menu key", "menu", Enum.KeyCode.RightShift, function()
		main.Visible = not main.Visible
