	-- window buttons
	closeB.MouseButton1Click:Connect(function()
		sfx("close")
		unloadHub()
	end)
	minB.MouseButton1Click:Connect(function()
		sfx("close")
		main.Visible = false
		if mini then mini.Visible = false end
	end)
	end -- fim de buildPages
	buildPages()

	-- ===== unload =====
	local function unload(mode)
		if not alive then return end
		alive = false
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		pcall(clearBypass)
		pcall(function() setGhost(false) end)
		pcall(clearTracers)
		pcall(function() restoreLight("all") end)
		pcall(function() lp.CameraMaxZoomDistance = origZoom end)
		pcall(function() for obj in pairs(esp) do drop(obj) end end)
		pcall(function() local h = getHum() if h then h.PlatformStand = false end end)
		pcall(function() saveConfig(S) end)
		pcall(function() root:Destroy() end)
		local G = (getgenv and getgenv()) or _G
		if mode then
			G.DoorsHubUnload = function()
				pcall(function() if blurFx then blurFx:Destroy() end gui:Destroy() end)
			end
			if mode == "floor" then task.defer(showLoader) else task.defer(launch, fi) end
		else
			G.DoorsHubUnload = nil
			pcall(function() if blurFx then blurFx:Destroy() blurFx = nil end end)
			pcall(function() gui:Destroy() end)
		end
	end
	do
		local G1 = (getgenv and getgenv()) or _G
		G1.DoorsHubUnload = unload
	end
	reloadUI = function()
		saveConfig(S)
		unload("reload")
	end

	-- ===== character events + anti AFK =====
	conn(lp.CharacterAdded, function(c)
		ghostOn, ghostOrig = false, {}
		deathBusy = false
		safePos = nil
		task.spawn(bindDeath, c)
	end)
	conn(lp.Idled, function()
		if S.afk then pcall(function() VU:CaptureController() VU:ClickButton2(Vector2.new()) end) end
	end)

	-- helpers shared by loops (one table = one local)
	local X = {}
	X.has = function(name)
		for obj, r in pairs(esp) do
			if r.text == name and obj.Parent and r.part.Parent then return r end
		end
	end
	X.remote = function(name, ...)
		local r = remoteNamed(name)
		if r then pcall(r.FireServer, r, ...) return true end
		return false
	end

	-- camera step (FOV + look away)
	pcall(function() RunService:UnbindFromRenderStep("DoorsHubCam") end)
	RunService:BindToRenderStep("DoorsHubCam", Enum.RenderPriority.Camera.Value + 1, function()
		if not alive then return end
		local cam = workspace.CurrentCamera
		if not cam then return end
		if S.fovOn then cam.FieldOfView = S.fov end
		if S.lookAway then
			local r = X.has("Eyes")
			if r then
				local v = r.part.Position - cam.CFrame.Position
				if v.Magnitude > 0 and v.Unit:Dot(cam.CFrame.LookVector) > 0.2 then
					local p = cam.CFrame.Position
					cam.CFrame = CFrame.lookAt(p, p + Vector3.new(0, -1, 0.01))
				end
			end
		end
	end)
	conns[#conns + 1] = { Disconnect = function() pcall(function() RunService:UnbindFromRenderStep("DoorsHubCam") end) end }

	-- ===== main loop =====
	X.s = { frames = 0, fpsT = os.clock(), fps = 60, tEsp = 0, tPerf = 0, tAuto = 0, tScan = 0, tNeut = 0, tBypass = 0, tHeal = 0, tSave = os.clock(), err = false, noted = {} }
	conn(RunService.Heartbeat, function(dt)
		if not alive then return end
		local ok, err = pcall(function()
			local Z = X.s
			local now = os.clock()
			local rt, hum = getRoot(), getHum()
			local cam = workspace.CurrentCamera

			Z.frames += 1
			if now - Z.fpsT >= 0.5 then
				Z.fps = math.floor(Z.frames / (now - Z.fpsT) + 0.5)
				Z.frames, Z.fpsT = 0, now
			end

			floatBtn.Visible = S.floatBtn or not main.Visible

			if now - Z.tEsp > 0.1 then
				Z.tEsp = now
				updateESP(rt)
				updateTracers(rt)
				updateRadar(rt)
				updateWarn(rt)
			end

			if now - Z.tPerf > 0.5 then
				Z.tPerf = now
				local ping = 0
				pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
				perfL.Text = Z.fps .. " FPS  |  " .. ping .. " ms"
				perfL.Visible = S.hud
				local room = latestRoomNum()
				if infoVals.Room then infoVals.Room.Text = tostring(room) end
				if infoVals.Status then
					local alv = hum and hum.Health > 0
					infoVals.Status.Text = alv and "Ready" or "Dead"
					infoVals.Status.TextColor3 = alv and T.green or T.red
				end
				if room ~= lastRoomSeen then
					lastRoomSeen = room
					roomStart = now
					if S.whRoom and room > 0 and room % 10 == 0 then
						sendWebhook("Room " .. room, "Reached room " .. room .. " on " .. F.name, 5763719)
					end
				end
				hudF.Visible = S.goldHud or S.timer
				if hudF.Visible then
					local g = getGold()
					hud1.Text = S.goldHud and ("Room " .. room .. (g and ("  |  Gold " .. tostring(g)) or "")) or "Speedrun"
					hud2.Text = S.timer and ("Run " .. fmtTime(now - runStart) .. "  |  Room " .. fmtTime(now - roomStart)) or ""
				end
			end

			if not rt or not hum then return end
			local live = hum.Health > 0

			if hum.FloorMaterial ~= Enum.Material.Air and live then safePos = rt.Position end

			local danger, dd = dangerNow(rt)
			local ghostWant = S.ghost or (S.autoGhost and danger ~= nil and (dd or 999) < 120)
			setGhost(ghostWant and live)

			if S.speed and live then
				local char = lp.Character
				local col = getCol()
				if S.speedMode == "attr" then
					pcall(function() char:SetAttribute("SpeedBoostBehind", math.max(0, S.speedVal - 16)) end)
				elseif S.speedMode == "walk" then
					hum.WalkSpeed = S.speedVal
				elseif S.speedMode == "cframe" then
					local md = hum.MoveDirection
					if md.Magnitude > 0 and not S.fly then
						noRB = math.max(noRB, now + 0.1)
						rt.CFrame = rt.CFrame + md * (S.speedVal - 16) * dt
					end
				end
				if S.antiRB and col then col.Massless = true end
			end

			if S.fly and cam and live then
				hum.PlatformStand = true
				local cf = cam.CFrame
				local rel = cf:VectorToObjectSpace(hum.MoveDirection)
				local dir = cf.LookVector * (-rel.Z) + cf.RightVector * rel.X
				if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
				if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end
				rt.AssemblyLinearVelocity = dir * S.flySpeed
			end

			if S.noclip or S.fly or (S.ghost and S.ghostNoclip) or (S.autoGhost and S.ghostNoclip and ghostOn) then
				local char = lp.Character
				if char then
					for _, d in ipairs(char:GetDescendants()) do
						if d:IsA("BasePart") and d.CanCollide then d.CanCollide = false end
					end
				end
			end

			if S.antiVoid and safePos and rt.Position.Y < -60 then
				noRB = now + 1
				rt.AssemblyLinearVelocity = Vector3.zero
				rt.CFrame = CFrame.new(safePos + Vector3.new(0, 4, 0))
				log("anti void: returned to safe position")
			end

			if S.fullbright then
				Lighting.Brightness, Lighting.ClockTime, Lighting.GlobalShadows = 2, 14, false
				Lighting.Ambient, Lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190), Color3.fromRGB(190, 190, 190)
			end
			if S.nofog then
				Lighting.FogEnd, Lighting.FogStart = 1e6, 1e6
				local a = Lighting:FindFirstChildOfClass("Atmosphere")
				if a then
					if not atmDensity then atmDensity = a.Density end
					a.Density = 0
				end
			end

			if now - Z.tBypass > 0.4 then
				Z.tBypass = now
				local nt = Z.noted
				if S.antiEyes and X.has("Eyes") then
					X.remote("MotorReplication", -649)
					if not nt.eyes then nt.eyes = true log("anti eyes active") end
				end
				if S.antiLookman and X.has("Lookman") then
					X.remote("MotorReplication", -649)
					if not nt.lookman then nt.lookman = true log("anti lookman active") end
				end
				if S.antiScreech and X.has("Screech") then
					X.remote("Screech", true)
					if not nt.screech then nt.screech = true log("auto screech active") end
				end
				if S.antiHalt and X.has("Halt") then
					X.remote("ClearHalt")
					if not nt.halt then nt.halt = true log("anti halt active (beta)") end
				end
				if S.antiA90 then
					local pg = lp:FindFirstChild("PlayerGui")
					local mu = pg and pg:FindFirstChild("MainUI")
					if mu and mu:FindFirstChild("Jumpscare_A90", true) then
						X.remote("A90", true)
						if not nt.a90 then nt.a90 = true log("anti a-90 active") end
					end
				end
			end

			if now - Z.tNeut > 1 and (S.antiSeek or S.antiSnare or S.antiGiggle or S.antiHalt) then
				Z.tNeut = now
				neutralize()
			end

			if now - Z.tScan > 0.5 then
				Z.tScan = now
				for p in pairs(prompts) do
					if p.Parent then
						if S.instant then
							if origHold[p] == nil then origHold[p] = p.HoldDuration end
							p.HoldDuration = 0
						elseif origHold[p] ~= nil then
							p.HoldDuration = origHold[p]
							origHold[p] = nil
						end
						if S.reach then
							if origDist[p] == nil then origDist[p] = p.MaxActivationDistance end
							p.MaxActivationDistance = origDist[p] * S.reachMul
						elseif origDist[p] ~= nil then
							p.MaxActivationDistance = origDist[p]
							origDist[p] = nil
						end
					end
				end
			end

			if now - Z.tAuto > 0.15 and live and (S.auto or S.autoGold or S.autoCandy or S.libHelp or S.brkHelp) then
				Z.tAuto = now
				for p in pairs(prompts) do
					if p.Parent and p.Enabled then
						local pos = promptPos(p)
						if pos then
							local d = (pos - rt.Position).Magnitude
							local k = kindOf(p)
							local go, rng = false, S.range
							if S.autoGold and promptHas(p, { "gold", "coin" }) then
								go = true
							elseif S.autoCandy and promptHas(p, { "candy" }) then
								go = true
							elseif S.libHelp and promptHas(p, { "livehintbook" }) then
								go, rng = true, math.max(rng, 25)
							elseif S.brkHelp and promptHas(p, { "breakerpole" }) then
								go, rng = true, math.max(rng, 25)
							elseif S.auto then
								go = not ((k == "hide" and S.skipHide) or (k == "door" and S.skipDoor))
							end
							if go and d <= rng and now - (lastFire[p] or 0) > 0.6 then
								lastFire[p] = now
								fire(p)
							end
						end
					end
				end
			end

			if S.autoHide and live and danger and (dd or 999) < 90 and now - lastHideTry > 4 then
				lastHideTry = now
				if tpHide(true) then log("auto hide: " .. danger.text .. " nearby") end
			end

			if S.autoHeal and live and now - Z.tHeal > 3 and hum.MaxHealth > 0 and (hum.Health / hum.MaxHealth * 100) < S.healAt then
				Z.tHeal = now
				local bp = lp:FindFirstChild("Backpack")
				local tool = (bp and bp:FindFirstChild("Bandage")) or (lp.Character and lp.Character:FindFirstChild("Bandage"))
				if tool then
					pcall(function()
						if tool.Parent ~= lp.Character then hum:EquipTool(tool) end
						tool:Activate()
					end)
					log("auto heal: bandage used")
				end
			end

			if S.autoWalk and live and not walkBusy then task.spawn(walkToDoor) end

			if now - Z.tSave > 30 then
				Z.tSave = now
				saveConfig(S)
			end
		end)
		if not ok and not X.s.err then
			X.s.err = true
			report("loop", err)
		end
	end)

	-- ===== start =====
	selectTab("Home", true)
	main.Visible = true
	do
		local goal = target()
		uiScale.Scale = 0
		tw(uiScale, { Scale = goal }, 0.45, Enum.EasingStyle.Back)
	end
	for i, name in ipairs(tabOrder) do
		local t = tabs[name]
		task.delay(0.05 * i, function()
			if t.lbl.Parent then tw(t.lbl, { TextTransparency = 0 }, 0.25) end
		end)
	end
	sfx("open")
	notify("Doors Hub", "Loaded on " .. F.name, T.accent, 3)
	if S.autoUpdate then checkUpdate(true) end
end -- fim da função launch

