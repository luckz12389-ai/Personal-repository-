			if su:match("^https?://") then url = su end
			local ok, body = pcall(function() return game:HttpGet(url) end)
			local remote = ok and type(body) == "string" and body:match('local VERSION = "([%d%.]+)"')
			if not remote then
				if not silent then notify("Update", "Could not check for updates", T.red, 3) end
				return
			end
			if verNum(remote) > verNum(VERSION) then
				notify("Update available", "Version " .. remote .. " (you have " .. VERSION .. ")", T.yellow, 6)
			elseif not silent then
				notify("Update", "You are up to date (" .. VERSION .. ")", T.green, 3)
