	local function serverHop()
		task.spawn(function()
			local ok, res = pcall(function()
				return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
			end)
			if not ok or type(res) ~= "table" or not res.data then
				notify("Server hop", "Could not list servers", T.red, 3)
				return
			end
			local list = {}
			for _, s in ipairs(res.data) do
				if s.id ~= game.JobId and s.playing < s.maxPlayers then list[#list + 1] = s.id end
			end
			if #list == 0 then
				notify("Server hop", "No free server found", T.yellow, 3)
				return
			end
			notify("Server hop", "Joining another server...", T.accent2, 3)
			pcall(function() TPS:TeleportToPlaceInstance(game.PlaceId, list[math.random(#list)], lp) end)
		end)
	end
