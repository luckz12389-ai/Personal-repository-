	local whLast = 0
	local function sendWebhook(title, desc, color)
		local url = S.webhook or ""
		if url == "" or not reqFn then return false end
		if not (url:match("^https://discord%.com/api/webhooks/") or url:match("^https://discordapp%.com/api/webhooks/") or url:match("^https://%w+%.discord%.com/api/webhooks/")) then return false end
		task.spawn(function()
			local waitT = 1.3 - (os.clock() - whLast)
			if waitT > 0 then task.wait(waitT) end
			whLast = os.clock()
			pcall(reqFn, {
