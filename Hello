local SR = 22050
local function synth(parts)
	local total = 0
	for _, p in ipairs(parts) do total = math.max(total, p[3] + p[4]) end
	local n = math.floor(total * SR)
	local buf = table.create(n, 0)
	for _, p in ipairs(parts) do
		local f0, f1, t0, d, v, w = p[1], p[2], p[3], p[4], p[5], p[6]
		local s, len, ph = math.floor(t0 * SR), math.floor(d * SR), 0
		for i = 0, len - 1 do
			local k = i / len
			ph += 2 * math.pi * (f0 + (f1 - f0) * k) / SR
			local sm = math.sin(ph)
			if w == "sq" then sm = sm >= 0 and 0.55 or -0.55 end
			local idx = s + i + 1
			if idx <= n then buf[idx] += sm * math.min(1, i / 80) * (1 - k) ^ 2 * v end
		end
	end
	local out = table.create(n)
	for i = 1, n do out[i] = string.pack("<i2", math.floor(math.clamp(buf[i], -1, 1) * 30000)) end
	local data = table.concat(out)
	return "RIFF" .. string.pack("<I4", 36 + #data) .. "WAVEfmt " .. string.pack("<I4I2I2I4I4I2I2", 16, 1, 1, SR, SR * 2, 2, 16)
		.. "data" .. string.pack("<I4", #data) .. data
end
