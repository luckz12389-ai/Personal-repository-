	local function partOf(o)
		if o:IsA("BasePart") then return o end
		if o:IsA("Model") then return o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart", true) end
	end
	local function drop(obj)
		local r = esp[obj]
		if not r then return end
		for _, k in ipairs({ "bb", "hl" }) do if r[k] then pcall(function() r[k]:Destroy() end) end end
		esp[obj] = nil
		espCount -= 1
	end
	local function add(obj, text, cat)
		if esp[obj] then return true end
		if not obj.Parent then return true end
		local part = partOf(obj)
		if not part then return false end
		local col = S["c_" .. cat]
		local r = { part = part, cat = cat, text = text }
		r.hl = new("Highlight", { Adornee = obj, FillColor = col, OutlineColor = col, FillTransparency = 0.55, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop }, obj)
		r.bb = new("BillboardGui", { Adornee = part, Size = UDim2.fromOffset(170, 22), StudsOffset = Vector3.new(0, 2, 0), AlwaysOnTop = true }, part)
		r.lbl = new("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = text, TextColor3 = col, TextStrokeTransparency = 0.3, Font = Enum.Font.GothamBold, TextSize = S.textSize }, r.bb)
		esp[obj] = r
		espCount += 1
		return true
	end
	local function tryAdd(obj, text, cat)
		if add(obj, text, cat) then return end
		task.spawn(function()
			for _ = 1, 12 do
				task.wait(0.25)
				if not alive or not obj.Parent then return end
				if add(obj, text, cat) then return end
			end
		end)
	end
	local function updateESP(rt)
		for obj, r in pairs(esp) do
			if not obj.Parent or not r.part.Parent then
				drop(obj)
			else
				local on = S.espOn and S[r.cat]
				local d = rt and (r.part.Position - rt.Position).Magnitude or 0
				if on and r.cat ~= "entities" and d > S.maxDist then on = false end
				local col = S["c_" .. r.cat]
				r.bb.Enabled, r.hl.Enabled = on, on
				if on then
					r.hl.FillColor, r.hl.OutlineColor, r.lbl.TextColor3, r.lbl.TextSize = col, col, col, S.textSize
					r.lbl.Text = S.showDist and (r.text .. " [" .. math.floor(d) .. "m]") or r.text
				end
			end
		end
	end

